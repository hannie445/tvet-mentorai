# AI Coach Engine — OpenAI connection
# Copy this file to .env.local and fill in your own key.
# Never commit .env.local or a real API key to version control.

# Required. Your OpenAI API key. Used server-side only (in src/app/api/ai-coach/route.ts
# and src/lib/ai-coach-engine/openai-service.ts) — it is never sent to the browser.
OPENAI_API_KEY=

# Optional. Overrides the default chat model used by the AI Coach Engine.
OPENAI_MODEL=gpt-4o-mini

# Optional. Set to "true" to enable Demo Mode — the AI Coach Engine will skip
# the network/OpenAI call entirely and always return its local dummy content
# after a short simulated delay. Useful for reliable, fast competition demos
# with no dependency on network conditions or API quota. Must be prefixed
# with NEXT_PUBLIC_ so the client-side engine code can read it.
NEXT_PUBLIC_DEMO_MODE=false

